{
  "name": "@rnpa/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Event model, wire schema and report types shared by the agent, server, analyzer and dashboard.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./redact": {
      "types": "./dist/redact.d.ts",
      "default": "./dist/redact.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
