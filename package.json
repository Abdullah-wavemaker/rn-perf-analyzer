{
  "name": "rn-perf-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Record, correlate and analyze React Native Android app performance from an APK.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/analyzer",
    "packages/agent",
    "apps/server",
    "apps/dashboard"
  ],
  "scripts": {
    "build": "npm run build -w @rnpa/shared -w @rnpa/analyzer -w @rnpa/agent -w @rnpa/dashboard -w @rnpa/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "npm run dev -w @rnpa/server",
    "dev:dashboard": "npm run dev -w @rnpa/dashboard",
    "start": "node --disable-warning=ExperimentalWarning apps/server/dist/cli.js",
    "doctor": "node --disable-warning=ExperimentalWarning apps/server/dist/cli.js doctor",
    "audit:deps": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.8.3",
    "vitest": "^5.0.3"
  }
}
